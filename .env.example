# Configuración de Grafana Loki
LOKI_URL=http://localhost:3100
# Opcional: Credenciales para Basic Auth en Loki (dejar en blanco si no se requiere)
LOKI_USER=
LOKI_PASSWORD=
# Query personalizada de Loki (Excluye por defecto al bot, loki e internal_logs para evitar bucles)
LOKI_QUERY={job=~".+", container_name!="ai-devops-bot", container_name!="loki", container_name!="internal_logs", job!="internal_logs"} |~ "(?i)(error|fatal|panic)" !~ "LogAnalyzerBot"

# Configuración del Log (TEXT o JSON)
LOG_FORMAT=TEXT

# Selección de Proveedor de Inteligencia Artificial (groq, gemini, o ollama)
AI_PROVIDER=groq

# Proveedor: Groq API (Llama 3.3)
GROQ_API_KEY=tu_api_key_de_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Proveedor: Google Gemini (REST nativo)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# Proveedor: Ollama (AI Local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Configuración de Telegram Bot
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_telegram_chat_id_o_canal_aqui

# Seguridad del Autocurado (Whitelisting de IDs de usuario autorizados a ejecutar comandos, separados por coma)
TELEGRAM_ALLOWED_USER_IDS=

# Configuración del Monitor
POLL_INTERVAL_SECONDS=60
# Opcional: Silenciado de alertas repetidas en minutos (default: 15)
COOLDOWN_MINUTES=15
# Opcional: Puerto del servidor de salud y métricas Prometheus (default: 8000)
HEALTHCHECK_PORT=8000
# Opcional: Nivel de logs del bot (INFO o DEBUG para modo verboso)
LOG_LEVEL=INFO

