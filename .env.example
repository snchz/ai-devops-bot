# Modo de Ingestión de Logs ('docker' para Docker Socket nativo, o 'loki' para Grafana Loki)
LOG_SOURCE=docker

# Configuración de Docker Socket (usado cuando LOG_SOURCE=docker)
DOCKER_SOCKET=/var/run/docker.sock
# Opcional: Contenedores a ignorar separados por coma
IGNORED_CONTAINERS=ai-devops-bot,loki,promtail,dozzle,cadvisor,node-exporter,homepage,dockge-dockge-1

# Configuración de Grafana Loki (Opcional, solo si LOG_SOURCE=loki)
LOKI_URL=http://localhost:3100
# Opcional: Credenciales para Basic Auth en Loki (dejar en blanco si no se requiere)
LOKI_USER=
LOKI_PASSWORD=
# Query personalizada de Loki (Excluye por defecto al bot, loki e internal_logs, y filtra logs info/debug)
LOKI_QUERY={job=~".+", container_name!="ai-devops-bot", container_name!="loki", container_name!="internal_logs", job!="internal_logs"} |~ "(?i)(error|fatal|panic)" !~ "LogAnalyzerBot" !~ "(?i)level=\"?info\"\b" !~ "(?i)level=\"?debug\"\b"

# Configuración del Log (TEXT o JSON)
LOG_FORMAT=TEXT

# Selección de Proveedor de Inteligencia Artificial (groq, gemini, o ollama)
AI_PROVIDER=groq

# Proveedor: Groq API (Llama 3.3)
GROQ_API_KEY=tu_api_key_de_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Proveedor: Google Gemini (REST nativo)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# Proveedor: Ollama (AI Local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Opcional: Silenciado de alertas repetidas en minutos (default: 15)
COOLDOWN_MINUTES=15
# Opcional: Puerto del servidor de salud y métricas Prometheus (default: 8000)
HEALTHCHECK_PORT=8000
# Opcional: Nivel de logs del bot (INFO o DEBUG para modo verboso)
LOG_LEVEL=INFO
# Opcional: Ruta a la base de datos de historial SQLite (default: data/history.db)
DATABASE_PATH=data/history.db
