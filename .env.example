# Configuración de Docker Engine Socket
DOCKER_SOCKET=/var/run/docker.sock
# Opcional: Contenedores a ignorar separados por coma
IGNORED_CONTAINERS=ai-devops-bot,dozzle,cadvisor,node-exporter,homepage,dockge-dockge-1

# Configuración del Formato de Log (TEXT o JSON)
LOG_FORMAT=TEXT

# Selección de Proveedor de Inteligencia Artificial (groq, gemini, o ollama)
AI_PROVIDER=groq

# Proveedor: Groq API (Llama 3.3 / Llama 3.1)
GROQ_API_KEY=tu_api_key_de_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Proveedor: Google Gemini (REST nativo)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# Proveedor: Ollama (AI Local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Opcional: Silenciado de alertas repetidas en minutos (default: 15)
COOLDOWN_MINUTES=15

# Opcional: Puerto del servidor Web UI y REST API (default: 8000)
HEALTHCHECK_PORT=8000

# Opcional: Nivel de logs del bot (INFO o DEBUG para modo verboso)
LOG_LEVEL=INFO

# Opcional: Ruta a la base de datos de historial SQLite (default: data/history.db)
DATABASE_PATH=data/history.db
